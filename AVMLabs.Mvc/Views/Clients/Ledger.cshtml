@model AVMLabs.Mvc.Models.Clients.LedgerResponseModel

@{
    ViewData["Title"] = "Client Ledger";
    var totalInvoiced = Model.Entries.Where(x => x.EntryType == "Invoice").Sum(x => x.Debit);
    var totalPaid = Model.Entries.Where(x => x.EntryType == "Payment").Sum(x => x.Credit);
    var totalGatewayFees = Model.Entries.Where(x => x.EntryType == "GatewayFee").Sum(x => x.Debit);
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">@Model.ClientName - Ledger</h2>
        <div class="d-flex gap-2">
            <a href="/Clients/Index" class="btn btn-secondary">Back to Clients</a>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#paymentModal">Record Payment</button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Credit Limit</h6>
                    <h4>₹@Model.CreditLimit.ToString("N2")</h4>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Outstanding</h6>
                    <h4 id="totalOutstanding">₹@Model.TotalOutstanding.ToString("N2")</h4>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">NBL Status</h6>
                    <span id="nblStatus" class="badge @(Model.IsNbl ? "bg-success" : "bg-danger") fs-6">
                        @(Model.IsNbl ? "NBL" : "Non-NBL")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Debit</th>
                            <th>Credit</th>
                            <th>Running Balance</th>
                        </tr>
                    </thead>
                    <tbody id="ledgerBody">
                        @foreach (var entry in Model.Entries)
                        {
                            <tr class="@(entry.EntryType == "Invoice" ? "table-danger" : entry.EntryType == "Payment" ? "table-success" : "table-warning")">
                                <td>@entry.Date.ToString("dd-MM-yyyy")</td>
                                <td>@entry.Description</td>
                                <td>₹@entry.Debit.ToString("N2")</td>
                                <td>₹@entry.Credit.ToString("N2")</td>
                                <td>₹@entry.RunningBalance.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Total Invoiced</h6>
                    <h5 id="totalInvoiced">₹@totalInvoiced.ToString("N2")</h5>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Total Paid</h6>
                    <h5 id="totalPaid">₹@totalPaid.ToString("N2")</h5>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Total Gateway Fees</h6>
                    <h5 id="totalGatewayFees">₹@totalGatewayFees.ToString("N2")</h5>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Net Outstanding</h6>
                    <h5 id="netOutstanding">₹@Model.NetOutstanding.ToString("N2")</h5>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Record Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Amount</label>
                    <input type="number" id="paymentAmount" class="form-control" min="0.01" step="0.01" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Date</label>
                    <input type="date" id="paymentDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Mode</label>
                    <select id="paymentMode" class="form-select">
                        <option value="Cash">Cash</option>
                        <option value="Cheque">Cheque</option>
                        <option value="Online">Online</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Gateway Fee</label>
                    <input type="number" id="gatewayFee" class="form-control" readonly value="0.00" />
                </div>

                <div id="paymentError" class="text-danger"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="savePayment">Submit</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const clientId = @Context.Request.RouteValues["id"];

        const paymentMode = document.getElementById("paymentMode");
        const paymentAmount = document.getElementById("paymentAmount");
        const gatewayFee = document.getElementById("gatewayFee");

        function calculateGatewayFee() {
            const amount = parseFloat(paymentAmount.value) || 0;
            gatewayFee.value = paymentMode.value === "Online" ? (amount * 0.02).toFixed(2) : "0.00";
        }

        function formatAmount(value) {
            return Number(value).toLocaleString("en-IN", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function formatDate(value) {
            const date = new Date(value);
            return date.toLocaleDateString("en-GB");
        }

        function getEntryClass(entryType) {
            if (entryType === "Invoice")
                return "table-danger";

            if (entryType === "Payment")
                return "table-success";

            return "table-warning";
        }

        function updateLedger(ledger) {
            document.getElementById("ledgerBody").innerHTML = ledger.entries.map(entry => `
                <tr class="${getEntryClass(entry.entryType)}">
                    <td>${formatDate(entry.date)}</td>
                    <td>${entry.description}</td>
                    <td>₹${formatAmount(entry.debit)}</td>
                    <td>₹${formatAmount(entry.credit)}</td>
                    <td>₹${formatAmount(entry.runningBalance)}</td>
                </tr>
            `).join("");

            document.getElementById("totalOutstanding").textContent = `₹${formatAmount(ledger.totalOutstanding)}`;
            document.getElementById("totalInvoiced").textContent = `₹${formatAmount(ledger.totalInvoiced)}`;
            document.getElementById("totalPaid").textContent = `₹${formatAmount(ledger.totalPaid)}`;
            document.getElementById("totalGatewayFees").textContent = `₹${formatAmount(ledger.totalGatewayFees)}`;
            document.getElementById("netOutstanding").textContent = `₹${formatAmount(ledger.netOutstanding)}`;

            const nblStatus = document.getElementById("nblStatus");
            nblStatus.textContent = ledger.isNbl ? "NBL" : "Non-NBL";
            nblStatus.className = `badge ${ledger.isNbl ? "bg-success" : "bg-danger"} fs-6`;
        }

        paymentMode.addEventListener("change", calculateGatewayFee);
        paymentAmount.addEventListener("input", calculateGatewayFee);

        document.getElementById("savePayment").addEventListener("click", async function () {
            const amount = parseFloat(paymentAmount.value);
            const date = document.getElementById("paymentDate").value;
            const mode = paymentMode.value;
            const error = document.getElementById("paymentError");

            error.textContent = "";

            if (!amount || amount <= 0) {
                error.textContent = "Enter a valid payment amount.";
                return;
            }

            const response = await fetch("/Clients/RecordPayment", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    clientId: clientId,
                    amount: amount,
                    paymentDate: date,
                    mode: mode
                })
            });

            const result = await response.json();

            if (!response.ok || !result.success) {
                error.textContent = result.message || "Failed to record payment.";
                return;
            }

            const ledgerResponse = await fetch(`/Clients/LedgerData?id=${clientId}`);

            if (!ledgerResponse.ok) {
                error.textContent = "Payment recorded, but unable to refresh ledger.";
                return;
            }

            const ledger = await ledgerResponse.json();

            updateLedger(ledger);

            paymentAmount.value = "";
            paymentMode.value = "Cash";
            gatewayFee.value = "0.00";
            error.textContent = "";

            const modal = bootstrap.Modal.getInstance(document.getElementById("paymentModal"));
            modal.hide();
        });
    </script>
}